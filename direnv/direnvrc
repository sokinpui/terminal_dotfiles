# ~/.config/direnv/direnvrc

layout_gvm() {
  local version=$1
  if [[ -z "$version" ]]; then
    # Optional: Look for a .go-version file if no version is provided
    if [[ -f .go-version ]]; then
      version=$(cat .go-version)
    else
      echo "Error: no version specified for layout_gvm"
      return 1
    fi
  fi

  # Path to gvm's go installations (default location)
  local gvm_go_root="$GVM_ROOT/gos/$version"

  if [[ -d "$gvm_go_root" ]]; then
    export GOROOT="$gvm_go_root"
    PATH_add "$gvm_go_root/bin"

    # Optional: Set up a local GOPATH for the project (recommended for older projects)
    # export GOPATH="$PWD/.direnv/gopath"
    # PATH_add "$GOPATH/bin"

    echo "Using GVM: $version"
  else
    echo "Error: GVM version '$version' not found in $GVM_ROOT/gos/"
    return 1
  fi
}


layout_anaconda() {
  local name=$1
  local env_path=$(conda info --envs | grep "^$name " | awk '{print $NF}')
  if [[ -z "$env_path" ]]; then
    echo "Conda env '$name' not found."
    return 1
  fi
  export CONDA_PREFIX=$env_path
  export CONDA_DEFAULT_ENV=$name
  # THIS LINE IS CRUCIAL:
  PATH_add "$env_path/bin"
}

layout_uv() {
  if [[ -d ".venv" ]]; then
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
    log_status "No virtual environment exists. Executing \`uv venv\` to create one."
    uv venv
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [ -d ".venv/bin" ]; then
    PATH_add .venv/bin
  elif [ -d ".venv/Scripts" ]; then
    PATH_add .venv/Scripts
  fi

  export VIRTUAL_ENV
}


layout_poetry() {
  PYPROJECT_TOML="${PYPROJECT_TOML:-pyproject.toml}"
  if [[ ! -f "$PYPROJECT_TOML" ]]; then
    log_status "No pyproject.toml found. Run poetry init first."
    return 1
  fi

  # Find the directory of the virtualenv
  if [[ -d ".venv" ]]; then
    VIRTUAL_ENV="$(pwd)/.venv"
  else
    VIRTUAL_ENV=$(poetry env info --path 2>/dev/null ; true)
  fi

  # If it doesn't exist, create it and install all dependencies (including dev)
  if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
    log_status "No virtual environment found. Running poetry install..."
    poetry install --with dev
    VIRTUAL_ENV=$(poetry env info --path)
  fi

  PATH_add "$VIRTUAL_ENV/bin"
  export POETRY_ACTIVE=1
  export VIRTUAL_ENV
}

