# vi: set ft=conf

killall borders 2>/dev/null
# borders active_color=0xff4eed32 inactive_color=0xff494d64 width=5.0 hidpi=on &
borders active_color=0xff4eed32 inactive_color=0xff494d64 width=5.0 hidpi=on  &

yabai -m config layout                      bsp
yabai -m config auto_balance                off
yabai -m config top_padding                 5
yabai -m config bottom_padding              5
yabai -m config left_padding                5
yabai -m config right_padding               5
yabai -m config window_gap                  5

# New window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child
# yabai -m config window_topmost              on
yabai -m config split_type              auto

# floating windows are always on top (default: off)

yabai -m config mouse_modifier              cmd
yabai -m config focus_follows_mouse         autofocus
# yabai -m config focus_follows_mouse         off

# enable debug on
yabai -m config debug_output                off

# disable those app
yabai -m rule --add app="App Store"  manage=off
yabai -m rule --add app="Logi Options+"  manage=off
yabai -m rule --add app="WeChat"  manage=off
yabai -m rule --add app="^System Settings$" manage=on
yabai -m rule --add app="V2rayU" manage=off
yabai -m rule --add app="Karabiner-Elements" manage=off
yabai -m rule --add app="Karabiner-EventViewer" manage=off
yabai -m rule --add app="System Information" manage=off
yabai -m rule --add app="Raycast" manage=off
yabai -m rule --add app="minecraft" manage=off
yabai -m rule --add app="java" manage=off
yabai -m rule --add app="Logi Options" manage=off
yabai -m rule --add app="MeshCentral Router" manage=off
yabai -m rule --add app="Telegram" manage=off

yabai -m rule --add subrole="^AXSystemDialog$" manage=off
yabai -m rule --add title="^(Settings|Preferences|Copy|Move|Info)$" manage=off

# yabai -m signal --add event=system_woke action="yabai -m config focus_follows_mouse autofocus"
# yabai -m signal --add event=display_changed action="yabai -m config focus_follows_mouse autofocus"

# Reset focus_follows_mouse (change 'autofocus' to 'autoraise' if you want hovered windows to raise)
FFM_RESET="yabai -m config focus_follows_mouse off && yabai -m config focus_follows_mouse autofocus"

# System / Dock / Mission Control
yabai -m signal --add event=system_woke          action="$FFM_RESET"
yabai -m signal --add event=dock_did_restart     action="sleep 1 && $FFM_RESET"
yabai -m signal --add event=mission_control_exit action="$FFM_RESET"

# Display changes
yabai -m signal --add event=display_added   action="sleep 1 && $FFM_RESET"
yabai -m signal --add event=display_removed action="sleep 1 && $FFM_RESET"
yabai -m signal --add event=display_moved   action="sleep 1 && $FFM_RESET"
yabai -m signal --add event=display_resized action="sleep 1 && $FFM_RESET"
yabai -m signal --add event=display_changed action="$FFM_RESET"

# Space changes
yabai -m signal --add event=space_changed action="yabai -m window --focus mouse >/dev/null 2>&1; $FFM_RESET"

# Window / App lifecycle
yabai -m signal --add event=window_destroyed         action="$FFM_RESET"
yabai -m signal --add event=application_terminated   action="$FFM_RESET"
yabai -m signal --add event=application_hidden       action="$FFM_RESET"
yabai -m signal --add event=application_front_switched action="$FFM_RESET"
