{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "local-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "v100 llama.cpp server",
      "options": {
        "baseURL": "http://172.21.14.5:10000/v1",
        "apiKey": "not-needed"
      },

      "models": {
        "gpt-oss-120b": {
          "name": "gpt-oss-120b",
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      },

      "models": {
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B-A3B",
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }

    }
  },


  "provider": {
    "local-server": {
      "npm": "@ai-sdk/openai",
      "name": "My Local Server",
      "options": {
        "baseURL": "http://localhost:9001/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "aisrp/gemini-flash-latest": {
          "name": "Gemini Flash Latest",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
      }
    }
  },

  "permission": {
    "*": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "cat *": "allow"
    }
  }
}
